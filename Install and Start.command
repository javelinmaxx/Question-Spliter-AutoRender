#!/bin/bash
# Double-click in Finder. Compatible with the Bash 3.2 shipped by macOS.
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_dir"

failed() {
  result=$?
  if [ "$result" -ne 0 ] && [ "$result" -ne 130 ] && [ "$result" -ne 143 ]; then
    printf '\nCould not start the question bank. The error is shown above.\n'
    if [ -t 0 ]; then read -r -p 'Press Return to close this window…' ignored_reply || true; fi
  fi
}
trap failed EXIT

if [ "$(uname -s)" != Darwin ]; then
  printf 'This one-click launcher is for macOS. See README.md for other systems.\n' >&2
  exit 1
fi
helper="$repo_dir/.venv/physics-env.sh"
if [ -f "$helper" ] && /usr/bin/grep -Fqx '# Generated by scripts/setup_macos.sh' "$helper"; then
  source "$helper"
fi
if [ -x "$repo_dir/.venv/bin/python" ] && "$repo_dir/.venv/bin/python" scripts/check_installation.py; then
  if "$repo_dir/.venv/bin/python" scripts/check_installation.py --open-existing; then
    exit 0
  fi
  printf '\nStarting the question bank. Keep this Terminal open; Ctrl+C stops it.\n'
  "$repo_dir/.venv/bin/python" app.py
else
  printf '\nPreparing your Mac. Setup starts the app automatically when complete.\n'
  /bin/bash scripts/setup_macos.sh --bootstrap
fi
